alias weather='{ printf "Location|Conditions|Local Time|Sunrise|Sunset\n--------|----------|----------|-------|------\n"; curl -s "wttr.in/{Sydney,Tokyo,Beijing,Mumbai,Moscow,London,New+York,Chicago,Denver,Sacramento,Honolulu}?m&format=%l|%c+%t|%T|%S|%s\n" | awk -F"|" -v OFS="|" '\''{ if ($2 ~ /[0-9]+°C/) { match($2, /[-+]?[0-9]+/); c = substr($2, RSTART, RLENGTH); f = sprintf("%+d", int(c * 1.8 + 32)); sub(/°C/, "°C (" f "°F)", $2); } $3 = substr($3, 1, 5) " " substr($3, 9); $4 = substr($4, 1, 5); $5 = substr($5, 1, 5); print }'\''; } | column -t -s "|"'
