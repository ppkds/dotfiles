alias free='free -ht'
alias git-pull='(cd "$HOME/Dev/Git" && "$HOME/Dev/Git/dotfiles/handystuff/git-pull.sh")'     # (  ) enclosure runs the command in a separate, temporary sub-shell
alias git-status='(cd "$HOME/Dev/Git" && "$HOME/Dev/Git/dotfiles/handystuff/git-status.sh")' # (  ) enclosure runs the command in a separate, temporary sub-shell
alias links='links2 https://lite.duckduckgo.com/lite/'
alias localip="ip route get 1 2>/dev/null | awk '{print \$7;exit}' || ifconfig 2>/dev/null | awk '/inet / && !/127.0.0.1/ {print \$2;exit}'"
