# ls aliases
alias ls='ls --color=auto -ChFv --group-directories-first'         # more useful ls (list entries by columns + human readable + classify files + natural sort + group directories first)
alias ll='ls -lhFv --group-directories-first'                   # ls (long listing format + human readable + classify files + natural sort + group directories first)
alias lla='ls -alhFv --group-directories-first'                 # ls (include hidden files + long listing format + human readable + classify + natural sort + group directories first)
alias l='ls -CF'                                                # compact column listing with classification indicators (/ for dirs, * for executables)
alias sl='ls'                                                   # typo correction for ls

# Directory traversal
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'
alias -- -='cd -'
alias cd..='cd ..'
alias md='mkdir -pv'                                            # make parent directories if needed + verbose

# File and Directory aliases
alias cat='batcat'
alias chgrp='chgrp --preserve-root'                             # prevent accidental recursive changes on root
alias chmod='chmod --preserve-root'                             # prevent accidental recursive changes on root
alias chown='chown --preserve-root'                             # prevent accidental recursive changes on root
alias cp='cp -iv'                                               # prompt before overwrite + verbose
alias df='duf'
alias ln='ln -i'                                                # prompt before overwrite
alias mv='mv -iv'                                               # prompt before overwrite + verbose
alias rm='rm -Iv'                                               # prompt once before removing more than 3 files or recursively + verbose
alias tree='tree -C --dirsfirst'

# Convenience aliases
alias bashrc='source "$HOME/.bashrc"'                           # reload bash configuration
alias cls='clear'                                               # for muscle memory from DOS
alias comfyui='cd "$HOME/Dev/Git/ComfyUI" && source venv/bin/activate && CUDA_VISIBLE_DEVICES=0 python main.py --use-flash-attention'
alias localip="ip route get 1 2>/dev/null | awk '{print \$7;exit}' || ifconfig 2>/dev/null | awk '/inet / && !/127.0.0.1/ {print \$2;exit}'"
alias myip='curl -s https://ifconfig.me/ip && echo'
alias path='echo -e ${PATH//:/\\n}'                              # print PATH entries cleanly on separate lines
alias ping='ping -c 5 -W 3'
alias ports='ss -tulpn'                                         # show listening TCP/UDP sockets with process names and PIDs
alias sudo='sudo '                                              # expand subsequent alias (e.g., sudo ll)
alias weather='echo && { printf "Location|Conditions|Local Time|Sunrise|Sunset\n--------|----------|----------|-------|------\n"; curl -s "wttr.in/{Sydney,Tokyo,Beijing,Mumbai,Moscow,London,New+York,Chicago,Denver,Sacramento,Honolulu}?m&format=%l|%c+%t|%T|%S|%s\n" | awk -F"|" -v OFS="|" '\''{ if ($2 ~ /[0-9]+°C/) { match($2, /[-+]?[0-9]+/); c = substr($2, RSTART, RLENGTH); f = sprintf("%+d", int(c * 1.8 + 32)); sub(/°C/, "°C (" f "°F)", $2); } $3 = substr($3, 1, 5) " " substr($3, 9); $4 = substr($4, 1, 5); $5 = substr($5, 1, 5); print }'\''; } | column -t -s "|" && echo'
alias wget='wget -c'                                            # automatically resume partially downloaded files
alias ytdl='"$HOME/Dev/Git/yt-dlp/yt-dlp.sh"'
alias ytmp3='yt-dlp --extract-audio --audio-format mp3 --audio-quality 0'
