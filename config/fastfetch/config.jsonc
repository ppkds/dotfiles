// Customized: July 20, 2026 // Modified: October 26, 2026
// ॐ

{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
    "separator": ": ",
    "color": {
      "keys": "green"
    },
    "bar": {
      "char": {
        "elapsed": "■",
        "total": "·"
      },
      "border": {
        "left": "[",
        "right": "]"
      },
      "color": {
        "total": "white"
      },
      "width": 10
    }
  },
  "modules": [
    // --- System & Desktop Environment ---
    {
      "type": "uptime",
      "key": "Uptime"
    },
    {
      "type": "custom",
      "format": "\u001b[1;37m--- OS and System ---\u001b[0m"
    },
    {
      "type": "os",
      "key": "OS",
      "format": "{3} {12} {10}"
    },
    {
      "type": "kernel",
      "key": "Kernel"
    },
    {
      "type": "shell",
      "key": "Shell"
    },
    {
      "type": "terminal",
      "key": "Terminal"
    },
    {
      "type": "de",
      "key": "DE"
    },
    {
      "type": "packages",
      "key": "Packages"
    },
    {
      "type": "command",
      "key": "Host",
      "text": "hostname"
    },

    // --- Hardware & Power ---
    {
      "type": "custom",
      "format": "\u001b[1;37m--- Hardware & Power ---\u001b[0m"
    },
    {
      "type": "host",
      "key": "Model",
      "format": "{1}"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "temp": true
    },
    {
      "type": "gpu",
      "key": "GPU",
      "driverSpecific": true,
      "temp": true,
      "format": "{2}{?4} - {4}{?}"
    },
    {
      "type": "display",
      "key": "Display",
      "format": "{1}x{2} @ {3}Hz"
    },
    {
      "type": "command",
      "key": "Battery",
      "text": "bdir=$(ls -d /sys/class/power_supply/BAT* 2>/dev/null | head -n1); if [ -d \"$bdir\" ]; then cap=$(cat \"$bdir/capacity\" 2>/dev/null); st=$(cat \"$bdir/status\" 2>/dev/null); prof=$(powerprofilesctl get 2>/dev/null); [ -z \"$prof\" ] && prof=\"unknown\"; now=\"\"; pwr=\"\"; [ -f \"$bdir/energy_now\" ] && now=$(cat \"$bdir/energy_now\" 2>/dev/null); [ -z \"$now\" ] && [ -f \"$bdir/charge_now\" ] && now=$(cat \"$bdir/charge_now\" 2>/dev/null); [ -f \"$bdir/power_now\" ] && pwr=$(cat \"$bdir/power_now\" 2>/dev/null); [ -z \"$pwr\" ] && [ -f \"$bdir/current_now\" ] && pwr=$(cat \"$bdir/current_now\" 2>/dev/null); awk -v c=\"$cap\" -v s=\"$st\" -v p=\"$prof\" -v now=\"$now\" -v pwr=\"$pwr\" 'BEGIN {pct=int(c); b=int(pct/10); bar=\"\"; for(i=0;i<10;i++) {if(i<b) {if(i<2) col=\"\\033[91m\"; else if(i<5) col=\"\\033[93m\"; else col=\"\\033[92m\"; bar=bar col \"■\\033[0m\"} else bar=bar\"·\"}; time_str=\"\"; if(now>0 && pwr>0) {hrs=int(now/pwr); mins=int(((now%pwr)*60)/pwr); time_str=sprintf(\" (%d:%02d hours remaining)\", hrs, mins)}; printf \"[%s] (%d%%)%s [%s * %s]\", bar, pct, time_str, s, p}'; fi"
    },

    // --- Memory & Storage ---
    {
      "type": "custom",
      "format": "\u001b[1;37m--- Memory & Storage ---\u001b[0m"
    },
    {
      "type": "command",
      "key": "Memory",
      "text": "awk '/MemTotal:/ {t=$2} /MemAvailable:/ {a=$2} END {u=t-a; uG=u/1024/1024; tG=t/1024/1024; pct=(tG>0)?int((uG/tG)*100):0; b=int(pct/10); bar=\"\"; for(i=0;i<10;i++) {if(i<b) {if(i<5) col=\"\\033[92m\"; else if(i<8) col=\"\\033[93m\"; else col=\"\\033[91m\"; bar=bar col \"■\\033[0m\"} else bar=bar\"·\"}; printf \"[%s] %.2f GiB / %.2f GiB (%d%%)\", bar, uG, tG, pct}' /proc/meminfo"
    },
    {
      "type": "command",
      "key": "Drive",
      "text": "dev=$(lsblk -dno NAME,TYPE | awk '$2==\"disk\" && $1!~/(loop|zram|ram)/ {print $1}' | sed -n '1p'); if [ -n \"$dev\" ]; then tB=$(lsblk -bno SIZE \"/dev/$dev\" | head -n1); uK=$(df -k | grep \"/dev/$dev\" | awk '{s+=$3} END {print s}'); [ -z \"$uK\" ] && uK=0; vendor=$(cat /sys/class/block/\"$dev\"/device/vendor 2>/dev/null | sed 's/^[ \t]*//;s/[ \t]*$//'); model=$(cat /sys/class/block/\"$dev\"/device/model 2>/dev/null | sed 's/^[ \t]*//;s/[ \t]*$//'); [ -z \"$model\" ] && model=$(lsblk -dno MODEL \"/dev/$dev\" | sed 's/^[ \t]*//;s/[ \t]*$//'); full_mdl=\"\"; if [ -n \"$vendor\" ] && [ -n \"$model\" ] && [ \"$vendor\" != \"$model\" ]; then full_mdl=\"$vendor $model\"; else full_mdl=\"${model:-$vendor}\"; fi; [ -z \"$full_mdl\" ] && full_mdl=\"Generic Drive\"; awk -v u=\"$uK\" -v t=\"$tB\" -v mdl=\"$full_mdl\" -v d=\"/dev/$dev\" 'BEGIN {uG=u/1024/1024; tG=t/1024/1024/1024; pct=(tG>0)?int((uG/tG)*100):0; b=int(pct/10); bar=\"\"; for(i=0;i<10;i++) {if(i<b) {if(i<5) col=\"\\033[92m\"; else if(i<8) col=\"\\033[93m\"; else col=\"\\033[91m\"; bar=bar col \"■\\033[0m\"} else bar=bar\"·\"}; printf \"[%s] %.2f GiB / %.2f GiB (%d%%) - %s - %s\", bar, uG, tG, pct, mdl, d}'; fi"
    },
    {
      "type": "command",
      "key": "Drive",
      "text": "dev=$(lsblk -dno NAME,TYPE | awk '$2==\"disk\" && $1!~/(loop|zram|ram)/ {print $1}' | sed -n '2p'); if [ -n \"$dev\" ]; then tB=$(lsblk -bno SIZE \"/dev/$dev\" | head -n1); uK=$(df -k | grep \"/dev/$dev\" | awk '{s+=$3} END {print s}'); [ -z \"$uK\" ] && uK=0; vendor=$(cat /sys/class/block/\"$dev\"/device/vendor 2>/dev/null | sed 's/^[ \t]*//;s/[ \t]*$//'); model=$(cat /sys/class/block/\"$dev\"/device/model 2>/dev/null | sed 's/^[ \t]*//;s/[ \t]*$//'); [ -z \"$model\" ] && model=$(lsblk -dno MODEL \"/dev/$dev\" | sed 's/^[ \t]*//;s/[ \t]*$//'); full_mdl=\"\"; if [ -n \"$vendor\" ] && [ -n \"$model\" ] && [ \"$vendor\" != \"$model\" ]; then full_mdl=\"$vendor $model\"; else full_mdl=\"${model:-$vendor}\"; fi; [ -z \"$full_mdl\" ] && full_mdl=\"Generic Drive\"; awk -v u=\"$uK\" -v t=\"$tB\" -v mdl=\"$full_mdl\" -v d=\"/dev/$dev\" 'BEGIN {uG=u/1024/1024; tG=t/1024/1024/1024; pct=(tG>0)?int((uG/tG)*100):0; b=int(pct/10); bar=\"\"; for(i=0;i<10;i++) {if(i<b) {if(i<5) col=\"\\033[92m\"; else if(i<8) col=\"\\033[93m\"; else col=\"\\033[91m\"; bar=bar col \"■\\033[0m\"} else bar=bar\"·\"}; printf \"[%s] %.2f GiB / %.2f GiB (%d%%) - %s - %s\", bar, uG, tG, pct, mdl, d}'; fi"
    },
    {
      "type": "command",
      "key": "Drive",
      "text": "dev=$(lsblk -dno NAME,TYPE | awk '$2==\"disk\" && $1!~/(loop|zram|ram)/ {print $1}' | sed -n '3p'); if [ -n \"$dev\" ]; then tB=$(lsblk -bno SIZE \"/dev/$dev\" | head -n1); uK=$(df -k | grep \"/dev/$dev\" | awk '{s+=$3} END {print s}'); [ -z \"$uK\" ] && uK=0; vendor=$(cat /sys/class/block/\"$dev\"/device/vendor 2>/dev/null | sed 's/^[ \t]*//;s/[ \t]*$//'); model=$(cat /sys/class/block/\"$dev\"/device/model 2>/dev/null | sed 's/^[ \t]*//;s/[ \t]*$//'); [ -z \"$model\" ] && model=$(lsblk -dno MODEL \"/dev/$dev\" | sed 's/^[ \t]*//;s/[ \t]*$//'); full_mdl=\"\"; if [ -n \"$vendor\" ] && [ -n \"$model\" ] && [ \"$vendor\" != \"$model\" ]; then full_mdl=\"$vendor $model\"; else full_mdl=\"${model:-$vendor}\"; fi; [ -z \"$full_mdl\" ] && full_mdl=\"Generic Drive\"; awk -v u=\"$uK\" -v t=\"$tB\" -v mdl=\"$full_mdl\" -v d=\"/dev/$dev\" 'BEGIN {uG=u/1024/1024; tG=t/1024/1024/1024; pct=(tG>0)?int((uG/tG)*100):0; b=int(pct/10); bar=\"\"; for(i=0;i<10;i++) {if(i<b) {if(i<5) col=\"\\033[92m\"; else if(i<8) col=\"\\033[93m\"; else col=\"\\033[91m\"; bar=bar col \"■\\033[0m\"} else bar=bar\"·\"}; printf \"[%s] %.2f GiB / %.2f GiB (%d%%) - %s - %s\", bar, uG, tG, pct, mdl, d}'; fi"
    },
    {
      "type": "command",
      "key": "Drive",
      "text": "dev=$(lsblk -dno NAME,TYPE | awk '$2==\"disk\" && $1!~/(loop|zram|ram)/ {print $1}' | sed -n '4p'); if [ -n \"$dev\" ]; then tB=$(lsblk -bno SIZE \"/dev/$dev\" | head -n1); uK=$(df -k | grep \"/dev/$dev\" | awk '{s+=$3} END {print s}'); [ -z \"$uK\" ] && uK=0; vendor=$(cat /sys/class/block/\"$dev\"/device/vendor 2>/dev/null | sed 's/^[ \t]*//;s/[ \t]*$//'); model=$(cat /sys/class/block/\"$dev\"/device/model 2>/dev/null | sed 's/^[ \t]*//;s/[ \t]*$//'); [ -z \"$model\" ] && model=$(lsblk -dno MODEL \"/dev/$dev\" | sed 's/^[ \t]*//;s/[ \t]*$//'); full_mdl=\"\"; if [ -n \"$vendor\" ] && [ -n \"$model\" ] && [ \"$vendor\" != \"$model\" ]; then full_mdl=\"$vendor $model\"; else full_mdl=\"${model:-$vendor}\"; fi; [ -z \"$full_mdl\" ] && full_mdl=\"Generic Drive\"; awk -v u=\"$uK\" -v t=\"$tB\" -v mdl=\"$full_mdl\" -v d=\"/dev/$dev\" 'BEGIN {uG=u/1024/1024; tG=t/1024/1024/1024; pct=(tG>0)?int((uG/tG)*100):0; b=int(pct/10); bar=\"\"; for(i=0;i<10;i++) {if(i<b) {if(i<5) col=\"\\033[92m\"; else if(i<8) col=\"\\033[93m\"; else col=\"\\033[91m\"; bar=bar col \"■\\033[0m\"} else bar=bar\"·\"}; printf \"[%s] %.2f GiB / %.2f GiB (%d%%) - %s - %s\", bar, uG, tG, pct, mdl, d}'; fi"
    },
    {
      "type": "command",
      "key": "Swap",
      "text": "awk '/SwapTotal:/ {t=$2} /SwapFree:/ {f=$2} END {u=t-f; uG=u/1024/1024; tG=t/1024/1024; pct=(tG>0)?int((uG/tG)*100):0; b=int(pct/10); bar=\"\"; for(i=0;i<10;i++) {if(i<b) {if(i<5) col=\"\\033[92m\"; else if(i<8) col=\"\\033[93m\"; else col=\"\\033[91m\"; bar=bar col \"■\\033[0m\"} else bar=bar\"·\"}; printf \"[%s] %.2f GiB / %.2f GiB (%d%%)\", bar, uG, tG, pct}' /proc/meminfo"
    },

    // --- Connectivity ---
    {
      "type": "custom",
      "format": "\u001b[1;37m--- Connectivity ---\u001b[0m"
    },
    {
      "type": "command",
      "key": "Bluetooth",
      "text": "DEVS=$(bluetoothctl devices Connected | awk '{print $2}' | while read -r mac; do info=$(bluetoothctl info \"$mac\"); name=$(echo \"$info\" | awk '/Name:/ {sub(/.*Name: /, \"\"); print $0}'); bat=$(echo \"$info\" | awk '/Battery Percentage:/ {gsub(/.*\\(|\\).*/, \"\"); print $0}'); if [ -n \"$bat\" ]; then echo \"$name ($bat%)\"; else echo \"$name\"; fi; done); if [ -n \"$DEVS\" ]; then echo \"$DEVS\" | paste -sd '*' - | sed 's/\\*/ * /g'; else echo \"No Connected Devices\"; fi"
    },
    {
      "type": "command",
      "key": "LAN (Device * MAC)",
      "text": "ip -br link | awk '$2==\"UP\" && $1!=\"lo\" {print $1 \" * \" $3}' | paste -sd '*' - | sed 's/\\*/ * /g'"
    },
    {
      "type": "command",
      "key": "IP (Local * Gateway * Public)",
      "text": "LOC_IPS=$(ip -br addr | awk '$2==\"UP\" && $1!=\"lo\" {split($3,a,\"/ \"); print a[1]}' | paste -sd '*' - | sed 's/\\*/ * /g'); GW=$(ip route show default | awk '{print $3}' | head -n1); PIP=$(curl -s --connect-timeout 2 ifconfig.me); echo \"$LOC_IPS * $GW * $PIP\""
    },
    {
      "type": "command",
      "key": "Listening",
      "text": "ports=$(ss -tlpn 2>/dev/null | awk 'NR>1 {split($4,a,\":\"); print a[length(a)]}' | sort -n -u | paste -sd ', ' -); [ -n \"$ports\" ] && echo \"TCP: $ports\""
    },
    "break",

    // --- Color Block Footer ---
    {
      "type": "colors",
      "symbol": "block",
      "block": {
        "width": 3
      }
    }
  ]
}
