// Modified & Customized on July 20,2026
// ॐ

{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
    "separator": ": ",
    "color": {
      "keys": "green"
    },
    "bar": {
      "char": {
        "elapsed": "■",
        "total": "·"
      },
      "border": {
        "left": "[",
        "right": "]"
      },
      "color": {
        "total": "white"
      },
      "width": 14
    }
  },
  "modules": [
    // --- System & Desktop Environment ---
    {
      "type": "uptime",
      "key": "Uptime"
    },
    {
      "type": "os",
      "key": "OS",
      "format": "{3} {12} {10}"
    },
    {
      "type": "kernel",
      "key": "Kernel"
    },
    {
      "type": "shell",
      "key": "Shell"
    },
    {
      "type": "terminal",
      "key": "Terminal"
    },
    {
      "type": "terminalfont",
      "key": "Terminal Font"
    },
    {
      "type": "de",
      "key": "DE"
    },
    {
      "type": "font",
      "key": "Font"
    },
    {
      "type": "packages",
      "key": "Packages"
    },
    {
      "type": "locale",
      "key": "Locale"
    },
    {
      "type": "command",
      "key": "Host",
      "text": "hostname"
    },
    {
      "type": "separator",
      "string": "-"
    },

    // --- Hardware, Graphics & Power ---
    {
      "type": "host",
      "key": "Model",
      "format": "{1}"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "temp": true
    },
    {
      "type": "gpu",
      "key": "GPU",
      "driverSpecific": true,
      "temp": true,
      "format": "{2} - {4} ({dedicated-used} / {dedicated-total})"
    },
    {
      "type": "display",
      "key": "Display",
      "format": "{1}x{2} @ {3}Hz"
    },
    {
      "type": "battery",
      "key": "Battery",
      "percent": {
        "type": 3
      }
    },
    {
      "type": "separator",
      "string": "-"
    },

    // --- Memory & Storage ---
    {
      "type": "memory",
      "key": "Memory",
      "percent": {
        "type": 3
      }
    },
    {
      "type": "command",
      "key": "Disk (Boot)",
      "text": "df -kT /boot/efi | awk 'NR==2 {pct=int($6); bar_blocks=int(pct/7); bar=\"\"; for(i=0;i<14;i++) {if(i<bar_blocks) bar=bar\"\\033[32m■\\033[0m\"; else bar=bar\"·\"}; printf \"[%s] %.2f MiB / %.2f MiB (%d%%) - %s - %s\", bar, $4/1024, $3/1024, pct, $2, $1}'"
    },
    {
      "type": "command",
      "key": "Disk (/)",
      "text": "df -kT / | awk 'NR==2 {pct=int($6); bar_blocks=int(pct/7); bar=\"\"; for(i=0;i<14;i++) {if(i<bar_blocks) bar=bar\"\\033[32m■\\033[0m\"; else bar=bar\"·\"}; printf \"[%s] %.2f GiB / %.2f GiB (%d%%) - %s - %s\", bar, $4/1024/1024, $3/1024/1024, pct, $2, $1}'"
    },
    {
      "type": "command",
      "key": "Disk (/home)",
      "text": "df -kT /home | awk 'NR==2 {pct=int($6); bar_blocks=int(pct/7); bar=\"\"; for(i=0;i<14;i++) {if(i<bar_blocks) bar=bar\"\\033[32m■\\033[0m\"; else bar=bar\"·\"}; printf \"[%s] %.2f GiB / %.2f GiB (%d%%) - %s - %s\", bar, $4/1024/1024, $3/1024/1024, pct, $2, $1}'"
    },
    {
      "type": "command",
      "key": "Disk (Swap)",
      "text": "SWAP_DEV=$(swapon --show=NAME --noheadings | head -n1); if [ -n \"$SWAP_DEV\" ]; then free -b | awk -v dev=\"$SWAP_DEV\" '/Swap:/ {used=$3; total=$2; if(total==0) pct=0; else pct=int((used/total)*100); bar_blocks=int(pct/7); bar=\"\"; for(i=0;i<14;i++) {if(i<bar_blocks) bar=bar\"\\033[32m■\\033[0m\"; else bar=bar\"·\"}; printf \"[%s] %.2f GiB / %.2f GiB (%d%%) - swap - %s\", bar, used/1024/1024/1024, total/1024/1024/1024, pct, dev}'; else echo \"[··············] 0.00 GiB / 0.00 GiB (0%) - swap\"; fi"
    },
    {
      "type": "command",
      "key": "Drive (Linux NVMe)",
      "text": "DEV=$(df / | awk 'NR==2 {print $1}' | sed -E 's/p?[0-9]+$//'); uK=$(df -k | awk -v d=\"$DEV\" '$1 ~ d {s+=$3} END {print s}'); tB=$(lsblk -bno SIZE \"$DEV\" | head -n1); awk -v u=\"$uK\" -v t=\"$tB\" -v dev=\"$DEV\" 'BEGIN {uG=u/1024/1024; tG=t/1024/1024/1024; pct=int((uG/tG)*100); b=int(pct/7); bar=\"\"; for(i=0;i<14;i++) {if(i<b) bar=bar\"\\033[32m■\\033[0m\"; else bar=bar\"·\"}; printf \"[%s] %.2f GiB / %.2f GiB (%d%%) - %s\", bar, uG, tG, pct, dev}'"
    },
    {
      "type": "command",
      "key": "Drive (Win NVMe)",
      "text": "LDEV=$(df / | awk 'NR==2 {print $1}' | sed -E 's/p?[0-9]+$//'); WDEV=$(lsblk -dno NAME | grep -v \"$(basename \"$LDEV\")\" | head -n1); if [ -n \"$WDEV\" ]; then uK=$(df -k | awk -v d=\"$WDEV\" '$1 ~ d {s+=$3} END {print s}'); tB=$(lsblk -bno SIZE \"/dev/$WDEV\" | head -n1); awk -v u=\"$uK\" -v t=\"$tB\" -v dev=\"/dev/$WDEV\" 'BEGIN {uG=u/1024/1024; tG=t/1024/1024/1024; pct=int((uG/tG)*100); b=int(pct/7); bar=\"\"; for(i=0;i<14;i++) {if(i<b) bar=bar\"\\033[32m■\\033[0m\"; else bar=bar\"·\"}; printf \"[%s] %.2f GiB / %.2f GiB (%d%%) - %s\", bar, uG, tG, pct, dev}'; else echo \"Not Mounted\"; fi"
    },
    {
      "type": "separator",
      "string": "-"
    },

    // --- Network Info ---
    {
      "type": "command",
      "key": "Interface (Device * MAC)",
      "text": "IFACE=$(ip route show default | awk '{print $5}'); MAC=$(cat /sys/class/net/$IFACE/address); echo \"$IFACE * $MAC\""
    },
    {
      "type": "command",
      "key": "IP (Local * Gateway * Public)",
      "text": "LIP=$(ip route get 1.1.1.1 | awk '{print $7}'); GW=$(ip route show default | awk '{print $3}'); PIP=$(curl -s --connect-timeout 2 ifconfig.me); echo \"$LIP * $GW * $PIP\""
    },
    "break",

    // --- Color Block Footer ---
    {
      "type": "colors",
      "symbol": "block",
      "block": {
        "width": 3
      }
    }
  ]
}
